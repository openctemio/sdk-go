{
  "$schema": "https://schemas.openctem.io/ctis/2.0/report.json",
  "assets": [
    {
      "id": "asset-1",
      "technical": {
        "service": {
          "port": 443,
          "state": "open",
          "transport": "tcp"
        }
      },
      "type": "service",
      "value": "192.0.2.10:443/tcp"
    },
    {
      "id": "asset-2",
      "technical": {
        "service": {
          "port": 22,
          "state": "open",
          "transport": "tcp"
        }
      },
      "type": "service",
      "value": "192.0.2.10:22/tcp"
    }
  ],
  "metadata": {
    "channel": "scanner",
    "extensions": {
      "io.openctem": {
        "capability": "scan.ports@1"
      }
    },
    "properties": {
      "provenance": "<provenance>"
    }
  },
  "tool": {
    "name": "acme-ports",
    "version": "1.0.0"
  },
  "version": "2.0"
}
