{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openctemio/sdk-go/main/pkg/tool/schema/pack.v1.schema.json",
  "title": "OpenCTEM tool pack manifest (pack.yaml)",
  "description": "A tool pack: the tools that are versioned, built, signed and delivered together. Each tool keeps its own tool.yaml (tool.v1.schema.json). Unknown keys are refused. Rules that span files (the tier equals the highest minimum tier of the tools, every engine a tool names is listed, the tools need no newer SDK than requires.sdk) are enforced by `openctem tool validate`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "name", "version", "publisher", "license", "tier", "tools", "platforms", "requires"],
  "properties": {
    "apiVersion": {"const": "openctem.io/pack/v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]{1,64})?(\\+[0-9A-Za-z.-]{1,64})?$", "description": "Semantic version of the pack, no leading v. Any change to the pack's files needs a new version."},
    "description": {"type": "string", "maxLength": 1024},
    "publisher": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$", "description": "The publisher's namespace. A catalog binds it to the signing identity."},
    "license": {"type": "string", "pattern": "^[A-Za-z0-9.+() -]{1,128}$", "description": "SPDX license expression of the pack's own files."},
    "tier": {"enum": ["T0", "T1", "T2"], "description": "T0 passive, T1 active, T2 intrusive. Must equal the highest minimum tier of the pack's tools."},
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "path": {"type": "string", "maxLength": 256, "description": "The tool's directory relative to pack.yaml (default: the name); stays inside the pack directory."}
        }
      }
    },
    "engines": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "license"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 64},
          "license": {"type": "string", "pattern": "^[A-Za-z0-9.+() -]{1,128}$"},
          "url": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048},
          "sha256": {
            "type": "object",
            "propertyNames": {"enum": ["linux/amd64", "linux/arm64"]},
            "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["linux/amd64", "linux/arm64"]}
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk", "protocol"],
      "properties": {
        "sdk": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]{1,64})?(\\+[0-9A-Za-z.-]{1,64})?$"},
        "protocol": {"const": 1}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base"],
      "properties": {
        "base": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/:-]{0,254}@sha256:[0-9a-f]{64}$", "description": "Base image of the pack image, pinned by digest."}
      }
    }
  }
}
