{
  "description": "Schemas outside the subset or its limits; each must be refused with the error at schema_error_path (a JSON pointer into the schema).",
  "cases": [
    {
      "description": "$ref is not in the subset",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "a": {
            "$ref": "#/defs/x"
          }
        }
      },
      "schema_error_path": "/properties/a/$ref"
    },
    {
      "description": "oneOf is not in the subset",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "a": {
            "oneOf": [
              {
                "type": "string"
              }
            ]
          }
        }
      },
      "schema_error_path": "/properties/a/oneOf"
    },
    {
      "description": "if/then is not in the subset",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "a": {
            "type": "string"
          }
        },
        "if": {}
      },
      "schema_error_path": "/if"
    },
    {
      "description": "unknown x-octm annotation",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "a": {
            "type": "string",
            "x-octm-free-args": true
          }
        }
      },
      "schema_error_path": "/properties/a/x-octm-free-args"
    },
    {
      "description": "additionalProperties must be false at the root",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "a": {
            "type": "string"
          }
        }
      },
      "schema_error_path": "/additionalProperties"
    },
    {
      "description": "additionalProperties missing on a group",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "g": {
            "type": "object",
            "properties": {
              "a": {
                "type": "string"
              }
            }
          }
        }
      },
      "schema_error_path": "/properties/g/additionalProperties"
    },
    {
      "description": "groups may not nest",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "g": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "h": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        }
      },
      "schema_error_path": "/properties/g/properties/h/type"
    },
    {
      "description": "schema version required",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "schema_error_path": "/x-octm-schema-version"
    },
    {
      "description": "root must be an object type",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "schema_error_path": "/type"
    },
    {
      "description": "not an RE2 pattern (lookahead)",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "a": {
            "type": "string",
            "pattern": "^(?=x)"
          }
        }
      },
      "schema_error_path": "/properties/a/pattern"
    },
    {
      "description": "default outside its own range",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "a": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 9
          }
        }
      },
      "schema_error_path": "/properties/a/default"
    },
    {
      "description": "minimum above maximum",
      "schema": {
        "x-octm-schema-version": 1,
        "type": "object",
